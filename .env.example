# ==============================================
# PROJECT NIRVANA - GLOBAL ENVIRONMENT TEMPLATE
# ==============================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nirvana_dev?schema=public

# Redis (BullMQ & Cache)
REDIS_URL=redis://localhost:6379

# API
PORT=4000
API_PREFIX=api/v1
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_characters_long
CORS_ORIGIN=http://localhost:3000

# Web (Frontend)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Video (Daily.co)
DAILY_API_KEY=your_daily_api_key_here
NEXT_PUBLIC_DAILY_DOMAIN=your-subdomain.daily.co

# Payments (Razorpay Route)
RAZORPAY_KEY_ID=rzp_test_exampleKey
RAZORPAY_KEY_SECRET=rzp_test_secretKey
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Storage (S3 / MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=nirvana-uploads
S3_FORCE_PATH_STYLE=true

# Email (Mailpit local)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=support@projectnirvana.internal
